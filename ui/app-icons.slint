// VibePath's own icons, on the VibeWare 16-unit grid (1-unit strokes, 0/45/90 degrees,
// axis-aligned strokes on half units). The shared set lives in @vibeware.

export global AppIcons {
    // An admin step (one UAC prompt): a shield, flat top, square shoulders, a 45-degree point.
    out property <string> shield: "M 2.5 2.5 L 14.5 2.5 L 14.5 8.5 L 8.5 14.5 L 2.5 8.5 Z M 8.5 5 L 8.5 10";
    // Resolve: a path that branches to the one that wins.
    out property <string> resolve: "M 1.5 8.5 L 6.5 8.5 L 9.5 5.5 L 14.5 5.5 M 6.5 8.5 L 9.5 11.5 L 12.5 11.5 M 12.5 3.5 L 14.5 5.5 L 12.5 7.5";
    // Broadcast: a mast with waves on both sides.
    out property <string> broadcast: "M 8.5 7.5 L 8.5 14.5 M 5.5 4.5 L 3.5 6.5 L 3.5 8.5 L 5.5 10.5 M 11.5 4.5 L 13.5 6.5 L 13.5 8.5 L 11.5 10.5";
}
